{% set assetHash = helpers.random() %}

<!doctype html>
<html lang="{{ meta.lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    {%- if title -%}
      {{- title -}}
    {%- else -%}
      {{- meta.siteName -}}
    {%- endif -%}
  </title>

  <!-- CSS -->
  {% include "head/css-inline.njk" %}

  <!-- Meta -->
  {% include "head/meta-info.njk" %}
</head>

<body style="margin:0; padding:0; background:#0b1220; color:white; font-family:sans-serif;">

  <!-- MAIN CONTENT ONLY -->
  <main style="max-width:900px; margin:auto; padding:40px;">
    {{ content | safe }}
  </main>

</body>
</html>
