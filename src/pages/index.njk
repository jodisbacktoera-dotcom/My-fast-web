<style>
body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: #0f172a;
  color: white;
  overflow-x: hidden;
}

/* HERO */
.hero {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* TEXT */
h1 {
  font-size: 60px;
  background: linear-gradient(90deg, #38bdf8, #6366f1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* TYPING */
.typing {
  font-size: 20px;
  border-right: 2px solid;
  white-space: nowrap;
  overflow: hidden;
  width: 0;
  animation: typing 3s steps(30) forwards, blink .7s infinite;
}

@keyframes typing {
  to { width: 260px; }
}

@keyframes blink {
  50% { border-color: transparent; }
}

/* BUTTON */
.btn {
  margin-top: 20px;
  padding: 12px 25px;
  border-radius: 10px;
  text-decoration: none;
  color: white;
  background: linear-gradient(90deg, #6366f1, #38bdf8);
  transition: 0.3s;
}

.btn:hover {
  transform: scale(1.1);
}

/* SECTION */
.section {
  padding: 70px 20px;
  text-align: center;
}

/* CARDS */
.card {
  background: #1e293b;
  padding: 20px;
  margin: 15px;
  border-radius: 12px;
  display: inline-block;
  width: 250px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-10px);
}

/* SOCIAL */
a {
  color: #38bdf8;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  h1 { font-size: 35px; }
}
</style>

<!-- HERO -->
<div class="hero">
  <h1>Hi, I'm Satyarth 🚀</h1>
  <div class="typing">Frontend Developer 💻</div>

  <a href="#contact" class="btn">Contact Me</a>
</div>
 <!-- 🔥 Subprice Button -->
<div style="text-align:center; margin-top:40px;">
  <button class="subprice-btn" onclick="openPopup()">🔥 Subprice</button>
</div>

<!-- 🔥 Popup -->
<div id="popup" class="popup">
  <span class="close" onclick="closePopup()">✖</span>
  <img src="https://i.ibb.co/pjq2n9W1/subprice.jpg" alt="Subprice Image">
</div>

<style>
.subprice-btn {
  padding: 14px 28px;
  font-size: 20px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(45deg, #ff416c, #ff4b2b);
  color: white;
  cursor: pointer;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(255,75,43, 0.7); }
  70% { box-shadow: 0 0 0 20px rgba(255,75,43, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255,75,43, 0); }
}

.popup {
  display: none;
  position: fixed;
  z-index: 999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.8);
  justify-content: center;
  align-items: center;
}

.popup img {
  max-width: 90%;
  border-radius: 12px;
}

.close {
  position: absolute;
  top: 20px;
  right: 30px;
  font-size: 30px;
  color: white;
  cursor: pointer;
}
</style>

<script>
function openPopup() {
  document.getElementById("popup").style.display = "flex";
}
function closePopup() {
  document.getElementById("popup").style.display = "none";
}
</script>
